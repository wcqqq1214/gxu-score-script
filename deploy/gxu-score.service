[Unit]
Description=GXU grades and exams monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/gxu-score-script
Environment=TZ=Asia/Shanghai
Environment="NODE_OPTIONS=--dns-result-order=ipv4first --max-old-space-size=256"
ExecStart=/usr/bin/node --env-file=.env --import tsx/esm src/main.ts
ExecStopPost=/usr/bin/echo "任务退出 result=${SERVICE_RESULT} code=${EXIT_CODE} status=${EXIT_STATUS}"
TimeoutStartSec=10min
TimeoutStopSec=15s
KillMode=control-group
OOMPolicy=stop
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=64M
CPUAccounting=yes
CPUQuota=100%
TasksAccounting=yes
TasksMax=128
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gxu-score
